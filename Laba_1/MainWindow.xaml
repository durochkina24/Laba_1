<Window x:Class="Laba_1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактор противников" Height="650" Width="900">
    <Grid Background="#BFE3FF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="10">
            <TextBlock Text="Список противников:" FontWeight="Bold"/>
            <ListBox Name="EnemiesListBox" Height="120" Margin="0,5,0,10" SelectionChanged="EnemiesListBox_SelectionChanged"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="25"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Имя противника:"/>
                <TextBox Grid.Row="0" Grid.Column="1" Name="NameTextBox"/>

                <TextBlock Grid.Row="1" Text="Имя иконки:"/>
                <TextBox Grid.Row="1" Grid.Column="1" Name="IconNameTextBox" IsReadOnly="True"/>

                <TextBlock Grid.Row="2" Text="Базовое здоровье:"/>
                <TextBox Grid.Row="2" Grid.Column="1" Name="BaseLifeTextBox"/>

                <TextBlock Grid.Row="3" Text="Модиф здоровья:"/>
                <TextBox Grid.Row="3" Grid.Column="1" Name="LifeModifierTextBox"/>

                <TextBlock Grid.Row="4" Text="Базовое золото:"/>
                <TextBox Grid.Row="4" Grid.Column="1" Name="BaseGoldTextBox"/>

                <TextBlock Grid.Row="5" Text="Модиф золота:"/>
                <TextBox Grid.Row="5" Grid.Column="1" Name="GoldModifierTextBox"/>

                <TextBlock Grid.Row="6" Text="Шанс появления:"/>
                <TextBox Grid.Row="6" Grid.Column="1" Name="SpawnChanceTextBox"/>
            </Grid>

            <!-- Первый ряд кнопок редактора -->
            <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                <Button Content="Обновить" Click="UpdateButton_Click" Padding="10,5" Height="40"/>
                <Button Content="Загрузить иконки" Click="LoadIconsButton_Click" Margin="10,0,0,0" Padding="5"/>
                <Button Content="Добавить" Click="AddButton_Click" Margin="10,0,0,0" Padding="15,5"/>
                <Button Content="Удалить" Click="RemoveButton_Click" Margin="10,0,0,0" Padding="10,5"/>
                <Button Content="Сохранить" Click="SaveButton_Click" Margin="10,0,0,0" Padding="10,5"/>
                <Button Content="Загрузить" Click="LoadButton_Click" Margin="10,0,0,0" Padding="10,5"/>
            </StackPanel>

            <!-- Второй ряд: отдельная большая кнопка "Играть" -->
            <Button Content="▶ Играть" Click="PlayButton_Click"
                    Margin="0,15,0,0" Height="45" Width="200"
                    HorizontalAlignment="Left"
                    FontSize="16" FontWeight="Bold"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="10">
            <TextBlock Text="Иконки противников:" FontWeight="Bold"/>
            <ListBox Name="IconsListBox" Height="400" SelectionChanged="IconsListBox_SelectionChanged"/>
            <TextBlock Text="Главная иконка:" Margin="0,10,0,0"/>
            <Image Name="MainEnemyIcon" Height="64" HorizontalAlignment="Left"/>
        </StackPanel>
    </Grid>
</Window>