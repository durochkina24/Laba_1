<Window x:Class="Laba_1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактор противников" Height="600" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="10">
            <TextBlock Text="Список противников:" FontWeight="Bold"/>
            <ListBox Name="EnemiesListBox" Height="120" Margin="0,5,0,10" SelectionChanged="EnemiesListBox_SelectionChanged"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="25"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Enemy Name:"/>
                <TextBox Grid.Row="0" Grid.Column="1" Name="NameTextBox"/>

                <TextBlock Grid.Row="1" Text="Icon Name:"/>
                <TextBox Grid.Row="1" Grid.Column="1" Name="IconNameTextBox" IsReadOnly="True"/>

                <TextBlock Grid.Row="2" Text="Base life:"/>
                <TextBox Grid.Row="2" Grid.Column="1" Name="BaseLifeTextBox"/>

                <TextBlock Grid.Row="3" Text="Life modifier:"/>
                <TextBox Grid.Row="3" Grid.Column="1" Name="LifeModifierTextBox"/>

                <TextBlock Grid.Row="4" Text="Base gold:"/>
                <TextBox Grid.Row="4" Grid.Column="1" Name="BaseGoldTextBox"/>

                <TextBlock Grid.Row="5" Text="Gold modifier:"/>
                <TextBox Grid.Row="5" Grid.Column="1" Name="GoldModifierTextBox"/>

                <TextBlock Grid.Row="6" Text="Spawn chance:"/>
                <TextBox Grid.Row="6" Grid.Column="1" Name="SpawnChanceTextBox"/>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                <Button Content="Load Icons" Click="LoadIconsButton_Click" Margin="0,0,10,0" Padding="5"/>
                <Button Content="Add" Click="AddButton_Click" Margin="0,0,10,0" Padding="15,5"/>
                <Button Content="Remove" Click="RemoveButton_Click" Margin="0,0,10,0" Padding="10,5"/>
                <Button Content="Save" Click="SaveButton_Click" Margin="0,0,10,0" Padding="10,5"/>
                <Button Content="Load" Click="LoadButton_Click" Padding="10,5"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="10">
            <TextBlock Text="Иконки противников:" FontWeight="Bold"/>
            <ListBox Name="IconsListBox" Height="400" SelectionChanged="IconsListBox_SelectionChanged"/>
            <TextBlock Text="Главная иконка:" Margin="0,10,0,0"/>
            <Image Name="MainEnemyIcon" Height="64" HorizontalAlignment="Left"/>
        </StackPanel>
    </Grid>
</Window>